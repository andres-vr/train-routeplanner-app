<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:model="clr-namespace:Routeplanner.Model"
             xmlns:viewmodel="clr-namespace:Routeplanner.ViewModel"
             x:Class="Routeplanner.SavedPage"
             x:DataType="viewmodel:SavedViewModel">
    <ScrollView>
        <VerticalStackLayout
        Padding="30,0"
        Spacing="25">
            <CollectionView ItemsSource="{Binding _Trips}"
              SelectionMode="None"
              Grid.ColumnSpan="2">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:Trip">
                        <Grid Padding="10">
                            <Border Style="{StaticResource CardView}" Padding="10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                         Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:SavedViewModel}}, Path=GoToTripCommand}"
                         CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <!-- One-row horizontal layout -->
                                <VerticalStackLayout Spacing="5">
                                    <HorizontalStackLayout Spacing="25">
                                        <HorizontalStackLayout>
                                            <Label Text="{Binding startTime}" FontAttributes="Bold" />
                                            <Label Text=" ➝ " />
                                            <Label Text="{Binding endTime}" FontAttributes="Bold" />
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout>
                                            <Label Text="⏱" />
                                            <Label Text="{Binding duration}" />
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout>
                                            <Label Text="🔗" />
                                            <Label Text="{Binding connections}" />
                                        </HorizontalStackLayout>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <CollectionView ItemsSource="{Binding _Departures}"
              SelectionMode="None"
              Grid.ColumnSpan="2">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:Departure">
                        <Grid Padding="10">
                            <Border Style="{StaticResource CardView}" Padding="10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                         Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:SavedViewModel}}, Path=GoToDepartureCommand}"
                         CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <!-- One-row horizontal layout -->
                                <VerticalStackLayout Spacing="5">
                                    <HorizontalStackLayout Spacing="25">
                                        <HorizontalStackLayout>
                                            <Label Text="{Binding Time}" FontAttributes="Bold" />
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout>
                                            <Label Text="{Binding Origin}" FontAttributes="Bold" />
                                            <Label Text=" ➝ " />
                                            <Label Text="{Binding Destination}" FontAttributes="Bold" />
                                            <Label Text="{Binding Stops}"/>
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout>
                                            <Label Text="⏱" />
                                            <Label Text="{Binding TrainType}" />
                                            <Label Text="🔗" />
                                            <Label Text="{Binding Track}" />
                                        </HorizontalStackLayout>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>