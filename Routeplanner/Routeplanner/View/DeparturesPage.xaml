<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:model="clr-namespace:Routeplanner.Model"
             xmlns:viewmodel="clr-namespace:Routeplanner.ViewModel"
             x:Class="Routeplanner.DeparturesPage"
             x:DataType="viewmodel:DeparturesViewModel">
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding PageAppearingCommand}" />
    </ContentPage.Behaviors>
    <ScrollView>
        <VerticalStackLayout
        Padding="30,0"
        Spacing="25">
            <Label Text="" FontSize="3"/>
            <Entry 
            Placeholder="Geef een station in"
            Text="{Binding Station, Mode=TwoWay}"
            ClearButtonVisibility="WhileEditing">
                <Entry.Behaviors>
                    <toolkit:EventToCommandBehavior 
                    EventName="Completed" 
                    Command="{Binding CompletedCommand}"/>
                </Entry.Behaviors>
            </Entry>
            <VerticalStackLayout IsVisible="{Binding IsStationSuggestionsVisible}"
             BackgroundColor="White"
             Padding="5"
             Spacing="2"
             BindableLayout.ItemsSource="{Binding StationSuggestions}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding}"
           Padding="10"
           BackgroundColor="LightGray">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:DeparturesViewModel}}, Path=SelectStationCommand}"
                                  CommandParameter="{Binding .}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Button
            
            Text="Opties tonen" 
            Command="{Binding SearchCommand}"
            HorizontalOptions="Fill" />
            <CollectionView x:Name="DepartureList"
                ItemsSource="{Binding _Departures}"
                SelectionMode="None"
                Grid.ColumnSpan="2">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:Departure">
                        <Grid Padding="10">
                            <Border Style="{StaticResource CardView}" Padding="10">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                            Command="{Binding Source={x:Reference DepartureList}, Path=BindingContext.GoToDepartureCommand}"
                            CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="Auto,Auto, *, Auto, *, Auto">
                                        <Label Text="⏱" Grid.Column="0"/>
                                        <Label Text="{Binding Time}" Grid.Column="1" />
                                        <Label Text="{Binding Destination}" Grid.Column="3"/>
                                        <Label Text="{Binding TrainType}" Grid.Column="5" />
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,Auto, *, Auto">
                                        <Label Text="🛤️" Grid.Column="0" />
                                        <Label Text="{Binding Track}" Grid.Column="1" />
                                        <Button
                                        Text="{Binding SaveButtonText}"
                                        TextColor="White"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:DeparturesViewModel}}, Path=SaveCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="Blue"
                                        Grid.Column="3"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <ActivityIndicator 
            x:Name="LoadingSpinner" 
            IsRunning="True" 
            IsVisible="{Binding Loading}"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Color="Blue"
            WidthRequest="50"
            HeightRequest="50"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>