<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Routeplanner.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Routeplanner"
    Shell.FlyoutBehavior="Disabled"
    Title="Routeplanner">

    <TabBar>
        <Tab Title="Plan" Route="plan"
             Icon="route.png">
            <ShellContent
                ContentTemplate="{DataTemplate local:PlannerPage}"/>
        </Tab>
        <Tab Title="Departures" Route="departures"
              Icon="train.png">
            <ShellContent
                ContentTemplate="{DataTemplate local:DeparturesPage}"/>
        </Tab>
        <Tab Title="Saved" Route="saved"
             Icon="heart.png">
            <ShellContent
                ContentTemplate="{DataTemplate local:SavedPage}"/>
        </Tab>
    </TabBar>
    <ShellContent Route="tripdetails" ContentTemplate="{DataTemplate local:TripDetailsPage}"/> 
    <ShellContent Route="departuredetails" ContentTemplate="{DataTemplate local:DepartureDetailsPage}"/>
</Shell>